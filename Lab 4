import streamlit as st
import pandas as pd
import altair as alt

# Dataset
data = {
    'Age': [23, 29, 35, 42, 27, 31, 46, 38, 50, 25, 40, 33],
    'SleepHours': [7, 6, 8, 5, 7, 6, 6, 8, 5, 7, 6, 8],
    'ExerciseHours': [3, 2, 4, 1, 5, 2, 1, 3, 2, 4, 1, 3],
    'HappinessScore': [7.8, 6.5, 8.9, 5.2, 8.4, 6.9, 5.5, 7.2, 5.0, 8.0, 6.3, 8.7],
    'Income': [32000, 45000, 58000, 72000, 40000, 50000, 68000, 55000, 75000, 37000, 64000, 60000],
    'Occupation': ['Designer', 'Engineer', 'Manager', 'Teacher', 'Trainer', 'Nurse',
                   'Lawyer', 'Researcher', 'Manager', 'Artist', 'Consultant', 'Developer']
}

df = pd.DataFrame(data)

# Title
st.title("🌸 Lifestyle & Happiness Data Exploration")

st.write("""
This dashboard explores how sleep, exercise, and occupation affect overall happiness and income levels. 
""")

# Scatter plot
st.header("Exploratory Graphics: Interactive Scatter Plot")

scatter = alt.Chart(df).mark_circle(size=70).encode(
    x='SleepHours',
    y='HappinessScore',
    color='Occupation',
    tooltip=['Age', 'SleepHours', 'ExerciseHours', 'HappinessScore', 'Occupation']
).interactive()

st.altair_chart(scatter, use_container_width=True)

st.write("The scatter plot shows how sleep hours relate to happiness levels.")

# Bar chart
st.header("Presentation Graphics: Static Bar Chart")

bar = alt.Chart(df).mark_bar().encode(
    x='Occupation',
    y='mean(HappinessScore)',
    color='Occupation'
)

st.altair_chart(bar, use_container_width=True)

st.write("This static bar chart presents the average happiness score by occupation, highlighting which professions report higher happiness on average.")

# Multivariate data
st.header("Interactive Linked Highlighting for Lifestyle Variables")

highlight = alt.selection(type='single', on='mouseover', fields=['Occupation'], nearest=True)

scatter_linked = alt.Chart(df).mark_circle(size=70).encode(
    x='ExerciseHours',
    y='HappinessScore',
    color=alt.condition(highlight, 'Occupation', alt.value('lightgray')),
    tooltip=['Age', 'ExerciseHours', 'HappinessScore', 'Occupation']
).add_selection(highlight)

bar_linked = alt.Chart(df).mark_bar().encode(
    x='Occupation',
    y='mean(Income)',
    color=alt.condition(highlight, 'Occupation', alt.value('lightgray'))
)

linked_charts = scatter_linked | bar_linked

st.altair_chart(linked_charts, use_container_width=True)

st.write("This chart shows exercise, happiness, and income connect across different professions.")

st.header("Exercise Frequency Across Occupations")

exercise_bar = alt.Chart(df).mark_bar().encode(
    x='Occupation',
    y='mean(ExerciseHours)',
    color='Occupation',
    tooltip=['Occupation', 'mean(ExerciseHours)']
).interactive()

st.altair_chart(exercise_bar, use_container_width=True)

st.write("This chart reveals how frequently people in different occupations exercise, adding context to happiness and income trends.")
